# Neo4j Connection Settings
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=strong_secret_password_here

# API & Application Settings
API_PREFIX=/api/v1
APP_ENV=development

# JWT Authentication & RBAC Settings
JWT_SECRET=replace_with_a_secure_random_64_char_secret_key_for_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ISSUER=organlink-auth
JWT_AUDIENCE=organlink-api

